# Copy to .env.local and fill in. Never commit real keys.
# Variables without NEXT_PUBLIC_ stay on the server.

# AI provider (POST /api/ask). @ai-sdk/anthropic reads this name by default.
ANTHROPIC_API_KEY=
# Model id for /api/ask, e.g. claude-haiku-5-5. Set by env per the PRD.
ASK_MODEL=

# Signs the short-lived session ticket from GET /api/session (HMAC).
# Generate with: openssl rand -base64 32
ASK_SIGNING_SECRET=

# Upstash Redis for shared rate limits. Redis.fromEnv() reads these names.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PostHog analytics (public by design; inlined into the client bundle).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Contact form (POST /api/contact). Service not chosen yet.
CONTACT_EMAIL_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Browser-side fallback when the server send is blocked (PRD section 12).
NEXT_PUBLIC_CONTACT_PUBLIC_KEY=
